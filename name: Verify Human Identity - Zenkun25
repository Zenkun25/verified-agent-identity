name: Verify Human Identity - Zenkun25

on:
  workflow_dispatch:

jobs:
  setup:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Install ClawHub
        run: |
          npm install -g clawhub
          npx clawhub@latest install verified-agent-identity
          echo "✅ ClawHub & Verified Agent Identity berhasil diinstall untuk Zenkun25"
          echo "Sekarang buka GitHub Codespaces atau Termux untuk jalankan manualLinkHumanToAgent.js"
